    "tidev/ti.map": { "kind": "module", "apidoc": "apidoc" },
    "tidev/ti.facebook": { "kind": "module", "apidoc": "apidoc" },
    "tidev/ti.coremotion": { "kind": "module", "apidoc": "apidoc" },
    "tidev/ti.crypto": { "kind": "module", "apidoc": "apidoc" },
    "tidev/ti.urlsession": { "kind": "module", "apidoc": "apidoc" },
    "tidev/titanium-identity": { "kind": "module", "apidoc": "apidoc" },
    "tidev/ti.playservices": { "kind": "module", "apidoc": "apidoc" },
    "tidev/ti.geofence": { "kind": "module", "apidoc": "apidoc" },
    "tidev/appcelerator.ble": { "kind": "module", "apidoc": "apidoc" },
    "tidev/appcelerator.bluetooth": { "kind": "module", "apidoc": "apidoc" },
    "tidev/appcelerator.https": { "kind": "module", "apidoc": "apidoc" },
    "tidev/appcelerator.encrypteddatabase": { "kind": "module", "apidoc": "apidoc" },
