{
  "schemaVersion": 1,
  "name": "Titanium.UI.iOS.LivePhotoView",
  "kind": "view",
  "extends": "Titanium.UI.View",
  "inheritanceChain": [
    "Titanium.UI.View",
    "Titanium.Proxy"
  ],
  "platforms": [
    "iphone",
    "ipad",
    "macos"
  ],
  "since": {
    "iphone": "5.2.0",
    "ipad": "5.2.0",
    "macos": "9.2.0"
  },
  "summary": "A view to display a [Titanium.UI.iOS.LivePhoto](api:Titanium.UI.iOS.LivePhoto) object introduced in iOS 9.1.\n",
  "description": "Use the [Titanium.UI.iOS.createLivePhotoView](api:Titanium.UI.iOS#createLivePhotoView) method to create an new `LivePhotoView`.\n\nSpecifying either a `width` or `height` property for this view will scale its `livePhoto` with \nthe aspect ratio maintained, up to a maximum size that does not exceed its parent view.\n\nFor more infos on Live Photo's, refer to the official [Apple documentation](https://developer.apple.com/documentation/photosui/phlivephotoview).\n",
  "examples": [
    {
      "title": "Basic LivePhotoView",
      "code": "The following example shows how to create a simple Ti.UI.iOS.LivePhotoView:\n\n``` js\nvar window = Ti.UI.createWindow({\n    backgroundColor: \"white\"\n});\n\nvar btn1 = Ti.UI.createButton({\n    title: \"Select live photo!\",\n    top: 30\n});\n\nbtn1.addEventListener(\"click\", openGallery);\nwindow.add(btn1);\nwindow.open();\n\nfunction openGallery() {\n    Ti.Media.openPhotoGallery({\n        mediaTypes: [Ti.Media.MEDIA_TYPE_PHOTO, Ti.Media.MEDIA_TYPE_LIVEPHOTO],\n        success: function(e) {\n            var livePhoto = e.livePhoto // Live photo of type Ti.UI.iOS.LivePhoto\n\n            if (livePhoto) {\n                var livePhotoView = Ti.UI.iOS.createLivePhotoView({\n                    livePhoto: livePhoto,\n                    muted: true,\n                    width: 300\n                });\n\n                livePhotoView.addEventListener(\"start\", function(e) {\n                    Ti.API.warn(\"-- Start playback --\");\n                    Ti.API.warn(e);\n                });\n\n                livePhotoView.addEventListener(\"stop\", function(e) {\n                    Ti.API.warn(\"-- Stop playback --\");\n                    Ti.API.warn(e);\n                });\n              window.add(livePhotoView);\n            }\n        }\n    });\n}\n```\n"
    }
  ],
  "properties": [
    {
      "name": "livePhoto",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "The Live Photo displayed in the view.",
      "description": "You receive a new live photo object by selecting an existing photo from the photo gallery. \nNote: iOS 9.1 only allows to select existing photos from  the gallery, capturing new live \nphotos is not supported by the iOS public API, yet.\n",
      "type": [
        {
          "kind": "type",
          "name": "Titanium.UI.iOS.LivePhoto"
        }
      ]
    },
    {
      "name": "muted",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "A Boolean value that determines whether the view plays the audio content of its Live Photo.\n",
      "description": "The default value is `false`, indicating that the view plays audio content along with the motion \ncontent of its Live Photo. Change this value to `true` to play motion content but not audio content.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "Boolean"
        }
      ],
      "default": "false"
    }
  ],
  "methods": [
    {
      "name": "startPlaybackWithStyle",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Begins playback of Live Photo content in the view.",
      "description": "Use the `playbackStyle` parameter to choose whether to play the full motion and sound content of the \nLive Photo or only a brief section.\n\nTypically, an app does not need to directly control playback, because a Live Photo view provides interactive \nplayback control. Use this method only when non-interactive playback is appropriate-for example, to briefly \nanimate the content to indicate that a view contains a Live Photo rather than a still image.\n",
      "parameters": [
        {
          "name": "playbackStyle",
          "summary": "An option for how much of the Live Photo's motion and sound content to play.",
          "type": [
            {
              "kind": "primitive",
              "name": "Number"
            }
          ],
          "default": "Titanium.UI.iOS.LIVEPHOTO_PLAYBACK_STYLE_FULL"
        }
      ]
    },
    {
      "name": "stopPlayback",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Ends playback of Live Photo content in the view."
    }
  ],
  "events": [
    {
      "name": "start",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Fired when the Live Photo playback starts.",
      "properties": [
        {
          "name": "playbackStyle",
          "summary": "Returns the `playbackStyle` that was provided to start the playback.",
          "type": [
            {
              "kind": "primitive",
              "name": "Number"
            }
          ]
        }
      ]
    },
    {
      "name": "stop",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Fired when the Live Photo playback stops.",
      "properties": [
        {
          "name": "playbackStyle",
          "summary": "Returns the `playbackStyle` that was provided to start the playback.",
          "type": [
            {
              "kind": "primitive",
              "name": "Number"
            }
          ]
        }
      ]
    }
  ],
