{
  "schemaVersion": 1,
  "name": "Titanium.UI.Android.RadioButtons",
  "kind": "view",
  "extends": "Titanium.UI.View",
  "inheritanceChain": [
    "Titanium.UI.View",
    "Titanium.Proxy"
  ],
  "platforms": [
    "android"
  ],
  "since": "14.1.0",
  "summary": "An radio button group component.",
  "description": "| Android |\n| ------- |\n| ![Android](./radiobuttons_android.png) |\n\nAllows you to create a native Android radio button group.\n",
  "examples": [
    {
      "title": "Simple radio group with 3 radio buttons.",
      "code": "``` js\nconst win = Ti.UI.createWindow({});\nconst radioButtons = Ti.UI.Android.createRadioButtons({\n\tlabels: [\"option 1\", \"option 2\", \"option 3\"],\n\ttop: 10,\n\tleft: 10,\n\tselectedIndex: 1\n})\nwin.add(radioButtons);\nwin.open();\n```\n"
    }
  ],
  "properties": [
    {
      "name": "color",
      "platforms": [
        "android"
      ],
      "summary": "Defines the color of the labels",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        },
        {
          "kind": "type",
          "name": "Titanium.UI.Color"
        }
      ]
    },
    {
      "name": "labels",
      "platforms": [
        "android"
      ],
      "summary": "Array of labels for the radio buttons.",
      "description": "Each item in the array will be one radio button in the group.\n",
      "type": [
        {
          "kind": "generic",
          "name": "Array",
          "args": [
            {
              "kind": "primitive",
              "name": "String"
            }
          ]
        }
      ]
    },
    {
      "name": "selectedIndex",
      "platforms": [
        "android"
      ],
      "summary": "Index of the currently selected item.",
      "description": "The value is `-1` when no item is selected. Set the value to `-1` to clear the selection.\nThe component ignores an index that is not in the range of the labels.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "Number"
        }
      ],
      "default": "-1"
    },
    {
      "name": "tintColor",
      "platforms": [
        "android"
      ],
      "summary": "Defines the color of the radio circles.",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        },
        {
          "kind": "type",
          "name": "Titanium.UI.Color"
        }
      ]
    }
  ],
