  "methods": [],
  "events": [
    {
      "name": "link",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Fired when user interacts with a URL in the Label.",
      "description": "The URL is set using the [ATTRIBUTE_LINK](api:Titanium.UI#ATTRIBUTE_LINK) property on the [attributedString](api:Titanium.UI.Label#attributedString).\n\nOn Android, this event also fires if the `html` property is used instead of the `attributedString` property. This event will\nalso override the default behavior of opening the link in its default application.\n\nOn iOS, this is only valid on version 7 and above. In previous versions of the the Titanium SDK this event required a `longpress`\ngesture to be performed. Beginning with Titanium SDK 4.0.0, only a `singletap` gesture is required to invoke this event.\n",
      "since": {
        "iphone": "3.2.0",
        "ipad": "3.2.0",
        "android": "4.0.0"
      },
      "properties": [
        {
          "name": "url",
          "summary": "The URL that is associated with this event.",
          "type": [
            {
              "kind": "primitive",
              "name": "String"
            }
          ]
        },
        {
          "name": "range",
          "summary": "An array of two numbers [location, length] describing the character range of the text associated with this URL.",
          "type": [
            {
              "kind": "primitive",
              "name": "Array"
            }
          ]
        },
        {
          "name": "bubbles",
          "summary": "This is false. This event does not bubble",
          "type": [
            {
              "kind": "primitive",
              "name": "Boolean"
            }
          ]
        }
      ]
    }
  ],
