    {
      "name": "glassEffect",
      "platforms": [
        "iphone",
        "ipad"
      ],
      "summary": "The glass effect configuration to apply to the effect view.",
      "description": "Glass effects are an alternative to classic blur views introduced in iOS 26, providing\na more modern and visually appealing blur effect with additional customization options.\n\nWhen the glass effect is enabled, it will override any value set to the `effect` property.\nSee [GlassEffectConfiguration](api:GlassEffectConfiguration) for the available configuration options.\n",
      "type": [
        {
          "kind": "type",
          "name": "GlassEffectConfiguration"
        }
      ],
      "since": {
        "iphone": "13.0.0",
        "ipad": "13.0.0"
      },
      "osver": {
        "ios": {
          "min": "26.0"
        }
      },
      "inlined": {
        "name": "GlassEffectConfiguration",
        "summary": "Object of options for configuring the glass effect on a [Titanium.UI.iOS.BlurView](api:Titanium.UI.iOS.BlurView).",
        "description": "The parameters used when configuring a glass effect for a blur view. Glass effects are\nan alternative to classic blur views introduced in iOS 26, providing a more modern and\nvisually appealing blur effect with additional customization options.\n\nThe glass effect requires at least the `style` property to be set. On iOS versions prior\nto 26, setting this property will have no effect.\n",
        "properties": [
          {
            "name": "interactive",
            "platforms": [
              "iphone",
              "ipad"
            ],
            "summary": "Whether the glass effect responds to user interaction.",
            "description": "When set to `true`, the glass effect will respond to touch and other user\ninteractions, providing visual feedback. This can create a more dynamic\nand engaging user experience.\n",
            "type": [
              {
                "kind": "primitive",
                "name": "Boolean"
              }
            ],
            "default": "false",
            "optional": true
          },
          {
            "name": "style",
            "platforms": [
              "iphone",
              "ipad"
            ],
            "summary": "The style of the glass effect.",
            "description": "Specifies the visual style of the glass effect. Different styles provide\ndifferent levels of translucency and blur intensity.\n",
            "type": [
              {
                "kind": "primitive",
                "name": "Number"
              }
            ],
            "default": "<Titanium.UI.iOS.GLASS_EFFECT_STYLE_REGULAR>",
            "constants": [
              "Titanium.UI.iOS.GLASS_EFFECT_STYLE_CLEAR",
              "Titanium.UI.iOS.GLASS_EFFECT_STYLE_REGULAR"
            ]
          },
          {
            "name": "tintColor",
            "platforms": [
              "iphone",
              "ipad"
            ],
            "summary": "The tint color to apply to the glass effect.",
            "description": "The tint color modifies the appearance of the glass effect. You can specify\nthe color as a color name (e.g., \"red\"), a hex string (e.g., \"#FF0000\"),\nor an RGBA string (e.g., \"rgba(255, 0, 0, 0.5)\").\n\nIf not specified, the glass effect will use the default system appearance.\n",
            "type": [
              {
                "kind": "primitive",
                "name": "String"
              }
            ],
            "optional": true
          }
        ]
      }
    }
  ],
