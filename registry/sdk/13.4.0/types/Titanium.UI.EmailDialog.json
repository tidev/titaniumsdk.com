      "name": "barColor",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Bar color of the email dialog window, as a color name or hex triplet.\n",
      "description": "For information about color values, see the \"Colors\" section of [Titanium.UI](api:Titanium.UI).\n",
