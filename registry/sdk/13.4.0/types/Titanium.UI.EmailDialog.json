  "methods": [
    {
      "name": "addAttachment",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Adds an attachment.",
      "description": "On Android, multiple attachments may be added, but will only work if the user chooses to\nsend via the Android Gmail or K9 mail clients.\n\nThe Android \"Mail\" app, which is only available on some handsets, will only accept one\nattachment from a Titanium app.\n",
      "parameters": [
        {
          "name": "attachment",
          "summary": "Attachment to include in the email.",
          "type": [
            {
              "kind": "type",
              "name": "Titanium.Blob"
            },
            {
              "kind": "type",
              "name": "Titanium.Filesystem.File"
            }
          ]
        }
      ]
    },
    {
      "name": "isSupported",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Indicates whether sending email is supported by the system.",
      "description": "On iOS 10, the user is able to uninstall the built-in applications including Mail. Because\nof that, you should ensure to check if the email dialog is supported on the current device.\n",
      "returns": [
        {
          "type": [
            {
              "kind": "primitive",
              "name": "Boolean"
            }
          ]
        }
      ]
    },
    {
      "name": "open",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Opens this email dialog.",
      "parameters": [
        {
          "name": "options",
          "summary": "Supported on iOS only. Simple object to override animation. Note that the default here is equivalent to passing in `{ animated: true }` (while typically the default for [AnimatedOptions](api:AnimatedOptions) is false)\n",
          "type": [
            {
              "kind": "type",
              "name": "AnimatedOptions"
            }
          ],
          "optional": true,
          "default": "{ animated: true }"
        }
      ]
    }
  ],
  "events": [
    {
      "name": "complete",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Fired when this email dialog has completed sending an email.",
      "properties": [
        {
          "name": "success",
          "summary": "Indicates if the email was handled successfully.\nReturns `true` if request succeeded, `false` otherwise. Note that emails being\ndeleted or saved for later do count as success.\n",
          "type": [
            {
              "kind": "primitive",
              "name": "Boolean"
            }
          ]
        },
        {
          "name": "error",
          "summary": "Error message, if any returned. Will be undefined if `success` is `true`.",
          "type": [
            {
              "kind": "primitive",
              "name": "String"
            }
          ]
        },
        {
          "name": "code",
          "summary": "Error code.\nError code will be 0 if `success` is `true`, nonzero otherwise. If the error\nwas generated by the operating system, that system's error value is used.\nOtherwise, this value will be -1.\n",
          "type": [
            {
              "kind": "primitive",
              "name": "Number"
            }
          ]
        },
        {
          "name": "result",
          "summary": "Status of the email send process.\n\nThe `SAVED` and `CANCELLED` constants are iOS only.\n\nOn Android, this property will return `SENT` when the user discards or saves\na message.\n",
          "type": [
            {
              "kind": "primitive",
              "name": "Number"
            }
          ]
        }
      ]
    }
  ],
