  },
  "summary": "This interface represents an entity, either parsed or unparsed, in an XML document. Note that this models the entity itself not the entity declaration. The nodeName attribute that is inherited from Node contains the name of the entity. An Entity node does not have any parent.\nImplements the [DOM Level 2 API](https://www.w3.org/TR/DOM-Level-2-Core/core.html#ID-527DCFF2) on Android and iOS.",
  "properties": [
    {
      "name": "notationName",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "For unparsed entities, the name of the notation for the entity. For parsed entities, this is `null`.",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ],
      "permission": "read-only"
    },
    {
      "name": "publicId",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "The public identifier associated with the entity, if specified. If the public identifier was not specified, this is `null`.",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ],
      "permission": "read-only"
    },
    {
      "name": "systemId",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "The system identifier associated with the entity, if specified. If the system identifier was not specified, this is null.",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ],
      "permission": "read-only"
    }
  ],
