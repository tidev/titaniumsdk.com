    {
      "name": "title",
      "platforms": [
        "android"
      ],
      "summary": "Text to display next to the switch, when the checkbox or slider style is in use.",
      "description": "This property is only effective when the [style](api:Titanium.UI.Switch#style) property is set to\n[SWITCH_STYLE_CHECKBOX](api:Titanium.UI#SWITCH_STYLE_CHECKBOX) or\n[SWITCH_STYLE_SLIDER](api:Titanium.UI#SWITCH_STYLE_SLIDER).\n\nUse the [textAlign](api:Titanium.UI.Switch#textAlign) property to align this text within the switch.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ]
    },
    {
      "name": "titleOff",
      "platforms": [
        "android"
      ],
      "summary": "Text to display on the switch in its \"off\" state, when the toggle button style is in use.",
      "description": "Set to an empty string to remove title text.\n\nIt is typically useful to set the `width` and/or `height` properties, to prevent the switch\nchanging size between its on/off state.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ],
      "default": "Off"
    },
    {
      "name": "titleOn",
      "platforms": [
        "android"
      ],
      "summary": "Text to display on the switch in its \"on\" state, when the toggle button style is in use.",
      "description": "Set to an empty string to remove title text.\n\nIt is typically useful to set the `width` and/or `height` properties, to prevent the switch\nchanging size between its on/off state.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ],
      "default": "On"
    },
    {
      "name": "value",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Indicates whether the switch has been turned on or off by the user. May also be set\nprogrammatically.\n",
      "description": "Set to `true` to turn on and `false` to turn off the switch.\n\nOn Android, if this property is not defined, the rendered state of the switch is off.\n\nOn iOS, be aware that this property must be set when the switch is rendered, otherwise it\nwill not be visible. This is a known issue.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "Boolean"
        }
      ],
      "default": "undefined (visual state off, Android)"
    },
