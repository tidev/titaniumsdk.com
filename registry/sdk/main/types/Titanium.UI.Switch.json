    {
      "name": "textAlign",
      "platforms": [
        "android"
      ],
      "summary": "Horizontal text alignment of the switch title.\n",
      "description": "This property is only applicable when the switch [style](api:Titanium.UI.Switch#style) is set to\n[SWITCH_STYLE_CHECKBOX](api:Titanium.UI#SWITCH_STYLE_CHECKBOX),\n[SWITCH_STYLE_SLIDER](api:Titanium.UI#SWITCH_STYLE_SLIDER), or\n[SWITCH_STYLE_TOGGLE_BUTTON](api:Titanium.UI#SWITCH_STYLE_TOGGLE_BUTTON),\n\nThis property is only effective if the [width](api:Titanium.UI.Switch#width) property is set to a\nvalue greater than the width of the [title](api:Titanium.UI.Switch#title) contents.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        },
        {
          "kind": "primitive",
          "name": "Number"
        }
      ],
      "default": "<Titanium.UI.TEXT_ALIGNMENT_CENTER> (toggle button, Android),\n<Titanium.UI.TEXT_ALIGNMENT_LEFT> (slider, Android),\n<Titanium.UI.TEXT_ALIGNMENT_LEFT> (checkbox, Android)\n",
