{
  "schemaVersion": 1,
  "name": "Titanium.XML.CharacterData",
  "kind": "proxy",
  "extends": "Titanium.XML.Node",
  "inheritanceChain": [
    "Titanium.XML.Node",
    "Titanium.Proxy"
  ],
  "platforms": [
    "android",
    "iphone",
    "ipad",
    "macos"
  ],
  "since": {
    "android": "0.9",
    "iphone": "0.9",
    "ipad": "0.9",
    "macos": "9.2.0"
  },
  "summary": "An interface extending [Titanium.XML.Node](api:Titanium.XML.Node) with a set of attributes and methods for accessing character data in the DOM.\nImplements the [DOM Level 2 API](https://www.w3.org/TR/DOM-Level-2-Core/core.html#ID-FF21A306) on Android and iOS. For reasons of compatibility with the javascript engine, text is represented by UTF-8 instead of UTF-16 on Android and iOS.",
  "properties": [
    {
      "name": "data",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "The character data of the node that implements this interface. Throws an exception during setting if this node is readonly.",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ]
    },
    {
      "name": "length",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "The number of characters that are available through data and the substringData method. This may have the value zero, i.e., [Titanium.XML.CharacterData](api:Titanium.XML.CharacterData) may be empty.",
      "type": [
        {
          "kind": "primitive",
          "name": "Number"
        }
      ],
      "permission": "read-only"
    }
  ],
  "methods": [
    {
      "name": "appendData",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Append the string to the end of the character data of the node. Upon success, data provides access to the concatenation of data and the string specified. Throws an exception if this node is readonly.",
      "parameters": [
        {
          "name": "arg",
          "summary": "The string to append.",
          "type": [
            {
              "kind": "primitive",
              "name": "String"
            }
          ]
        }
      ]
    },
    {
      "name": "deleteData",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Remove a range of characters from the node. Upon success, data and length reflect the change. Throws an exception if this node is readonly, if offset is negative, offset is beyond the data's length, or if count is negative.",
      "parameters": [
        {
          "name": "offset",
          "summary": "The offset from which to start removing.",
          "type": [
            {
              "kind": "primitive",
              "name": "Number"
            }
          ]
        },
        {
          "name": "count",
          "summary": "The number of characters to delete. If the sum of offset and count exceeds length then all characters from offset to the end of the data are deleted.",
          "type": [
            {
              "kind": "primitive",
              "name": "Number"
            }
          ]
        }
      ]
    },
    {
      "name": "insertData",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Insert a string at the specified offset. Throws an exception if this node is readonly, if offset is negative, or if offset is beyond the data's length.",
      "parameters": [
        {
          "name": "offset",
          "summary": "The character offset at which to insert.",
          "type": [
            {
              "kind": "primitive",
              "name": "Number"
            }
          ]
        },
        {
          "name": "arg",
          "summary": "The string to insert.",
          "type": [
            {
              "kind": "primitive",
              "name": "String"
            }
          ]
        }
      ]
    },
    {
      "name": "replaceData",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Replace the characters starting at the specified offset with the specified string. Throws an exception if this node is readonly, if offset is negative, offset is beyond the data's length, or if count is negative.",
      "parameters": [
        {
          "name": "offset",
          "summary": "The offset from which to start replacing.",
          "type": [
            {
              "kind": "primitive",
              "name": "Number"
            }
          ]
        },
        {
          "name": "count",
          "summary": "The number of characters to replace. If the sum of offset and count exceeds length, then all characters to the end of the data are replaced; (i.e., the effect is the same as a remove method call with the same range, followed by an append method invocation).",
          "type": [
            {
              "kind": "primitive",
              "name": "Number"
            }
          ]
        },
        {
          "name": "arg",
          "summary": "The string with which the range must be replaced.",
          "type": [
            {
              "kind": "primitive",
              "name": "String"
            }
          ]
        }
      ]
    },
    {
      "name": "substringData",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Extracts a range of data from the node. Throws an exception if offset is negative, offset is beyond the data's length, or if count is negative.",
      "parameters": [
        {
          "name": "offset",
          "summary": "Start offset of substring to extract.",
          "type": [
            {
              "kind": "primitive",
              "name": "Number"
            }
          ]
        },
        {
          "name": "count",
          "summary": "The number of characters units to extract.",
          "type": [
            {
              "kind": "primitive",
              "name": "Number"
            }
          ]
        }
      ],
      "returns": [
        {
          "type": [
            {
              "kind": "primitive",
              "name": "String"
            }
          ],
          "summary": "The specified substring. If the sum of offset and count exceeds the length, then all 16-bit units to the end of the data are returned."
        }
      ]
    }
  ],
