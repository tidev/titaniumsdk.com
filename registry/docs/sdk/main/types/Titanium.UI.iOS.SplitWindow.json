              "kind": "primitive",
              "name": "Boolean"
            }
          ]
        },
        {
          "name": "options",
          "summary": "Determines whether the scrollable region reposition should be animated. On iOS, use the optional property `animated` to animate changes to masterView display mode in portrait orientation. For example\n\n``` js\nsetMasterIsOverlayed(true, { animated: true });\n```\n\nNote that the default here is equivalent to passing in `{ animated: false }`\n",
          "type": [
            {
              "kind": "type",
              "name": "AnimatedOptions"
            }
          ],
          "optional": true,
          "default": "{ animated: false }"
        }
      ]
    },
    {
      "name": "setShowMasterInPortrait",
      "platforms": ["iphone", "ipad", "macos"],
      "summary": "Sets the value of the [showMasterInPortrait](api:Titanium.UI.iOS.SplitWindow#showMasterInPortrait) property.",
      "parameters": [
        {
          "name": "showMasterInPortrait",
          "summary": "Determines whether to show the master view in portrait orientation.",
          "type": [
            {
              "kind": "primitive",
              "name": "Boolean"
            }
          ]
        },
        {
          "name": "options",
          "summary": "Determines whether the scrollable region reposition should be animated. On iOS, use the optional property `animated` to animate changes to masterView display mode in portrait orientation. For example\n\n``` js\nsetShowMasterInPortrait(true, { animated: true });\n```\n\nNote that the default here is equivalent to passing in `{ animated: false }`\n",
          "type": [
            {
              "kind": "type",
              "name": "AnimatedOptions"
            }
          ],
          "optional": true,
          "default": "{ animated: false }"
        }
      ]
    }
  ],
