        }
      ]
    },
    {
      "name": "wraps",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "If YES, incrementing beyond [Titanium.UI.iOS.Stepper.maximum](api:Titanium.UI.iOS.Stepper#maximum) sets value to [Titanium.UI.iOS.Stepper.minimum](api:Titanium.UI.iOS.Stepper#minimum). likewise, decrementing below\n[Titanium.UI.iOS.Stepper.minimum](api:Titanium.UI.iOS.Stepper#minimum) sets value to [Titanium.UI.iOS.Stepper.maximum](api:Titanium.UI.iOS.Stepper#maximum). If NO, the stepper does not increment beyond [Titanium.UI.iOS.Stepper.maximum](api:Titanium.UI.iOS.Stepper#maximum) nor\ndoes it decrement below [Titanium.UI.iOS.Stepper.minimum](api:Titanium.UI.iOS.Stepper#minimum) but rather holds at those values.\nThe default value is NO.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "Boolean"
        }
      ]
    }
  ],
