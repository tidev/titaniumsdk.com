{
  "schemaVersion": 1,
  "name": "Titanium.UI.iOS.Stepper",
  "kind": "view",
  "extends": "Titanium.UI.View",
  "inheritanceChain": [
    "Titanium.UI.View",
    "Titanium.Proxy"
  ],
  "platforms": [
    "iphone",
    "ipad",
    "macos"
  ],
  "since": {
    "iphone": "5.4.0",
    "ipad": "5.4.0",
    "macos": "9.2.0"
  },
  "summary": "A widget used to increment and decrement a value.\n",
  "description": "| Default | Custom |\n| ------- | ------ |\n| ![Stepper](./stepper.png) | ![Custom](./stepper_custom.png) |\n\nA Stepper displays its selected state while it is being pressed.\nYou can specify background images for each state on iOS.\nUse the [Titanium.UI.iOS.createStepper](api:Titanium.UI.iOS#createStepper) method or a **`<Stepper>`** Alloy element to create a stepper\n(see the \"Examples\" section details).\n\n* When assigning a custom image to the `backgroundImage` property, the image must be\npartially or wholly transparent for the background color or background gradient to be visible.\n* Similarly, for an assigned background gradient to show through, the `backgroundColor` may need to be\nset to 'transparent'.\n\n* Note that the stepper cannot be re-sized.\n",
  "examples": [
    {
      "title": "Simple Stepper Example",
      "code": "``` js\nvar win = Ti.UI.createWindow({\n    backgroundColor: '#fff'\n});\n\nvar stepper = Ti.UI.iOS.createStepper({\n    tintColor: \"green\",\n    steps: 3,\n    maximum: 30,\n    minimum: 0\n});\n\nstepper.addEventListener(\"change\", function(e) {\n    Ti.API.info(e.value);\n});\n\nwin.add(stepper);\nwin.open();\n```\n"
    },
    {
      "title": "Alloy XML Markup",
      "code": "Previous example as an Alloy view.\n\nstepper.xml:\n``` xml\n<Alloy>\n    <Window id=\"window\">\n        <Stepper id=\"stepper\" onClick=\"doClick\" tintColor=\"green\" steps=\"3\" />\n    </Window>\n</Alloy>\n```\n\nstepper.js:\n``` js\nfunction doClick(e) {\n    alert(e.value);\n}\n\n$.window.open();\n```\n"
    }
  ],
  "properties": [
    {
      "name": "autorepeat",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "If YES, the user pressing and holding on the stepper repeatedly alters value.\nThe default value is YES.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "Boolean"
        }
      ]
    },
    {
      "name": "backgroundImage",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Background image for the stepper in its normal state, specified as a local file path or URL.\n",
      "description": "Also sets the background image for other stepper states (focused, selected),\nunless they've been specified explicitly. On iOS, if backgroundDisabledImage is unset, the\nimage will appear faded to indicate being disabled. Also on iOS, if backgroundSelectedImage\nis unset, the image will be darkened to indicate being selected.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ]
    },
    {
      "name": "continuous",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "If YES, value change events are sent immediately when the value changes during user interaction.\nIf NO, a value change event is sent when user interaction ends.\nThe default value is YES.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "Boolean"
        }
      ]
    },
    {
      "name": "decrementDisabledImage",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Background image for the stepper decrement button in its disabled state, specified as a local\nfile path or URL. The decrement button enters a disabled state ones the value is equal to the\nminimumValue , setting the enabled property to false will have no effect to decrement button state.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ]
    },
    {
      "name": "decrementImage",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Background image for the stepper decrement button in its normal state, specified as a local\nfile path or URL.\n",
      "description": "Also sets the background image for the other stepper states (disabled, focused, selected),\nunless they've been specified explicitly, except for iOS, which requires a backgroundImage.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ]
    },
    {
      "name": "enabled",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Determines if the stepper is enabled or disabled.",
      "type": [
        {
          "kind": "primitive",
          "name": "Boolean"
        }
      ]
    },
    {
      "name": "incrementDisabledImage",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Background image for the stepper increment button in its disabled state, specified as a local\nfile path or URL.The increment button enters a disabled state ones the value is equal to the\nmaximumValue , setting the enabled property to false will have no effect to increment button state.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ]
    },
    {
      "name": "incrementImage",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Background image for the stepper increment button in its normal state, specified as a local\nfile path or URL.\n",
      "description": "Also sets the background image for the other stepper states (disabled, focused, selected),\nunless they've been specified explicitly, except for iOS, which requires a backgroundImage.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ]
    },
    {
      "name": "maximum",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "The maximum value the stepper will be set to, the value must be greater than the minimum value.\nIf you attempt to set a value equal to or lower than minimum, the system will default the\nvalue to 100.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "Number"
        }
      ]
    },
    {
      "name": "minimum",
      "platforms": [
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "The minimum value the stepper will be set to, the value must be smaller than the maximum value.\nIf you attempt to set a value equal to or greater than maximum, the system will default the\nvalue to 0.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "Number"
        }
      ]
    },
    {
      "name": "steps",
