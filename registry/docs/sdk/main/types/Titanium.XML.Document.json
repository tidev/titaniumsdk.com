    {
      "name": "importNode",
      "platforms": [
        "android",
        "iphone",
        "ipad",
        "macos"
      ],
      "summary": "Imports a node from another document to this document,\nwithout altering or removing the source node from the original document.\n",
      "description": "This method creates a new copy of the source node, ready to be inserted into\nthis document.  The returned node has an [ownerDocument](api:Titanium.XML.Node#ownerDocument)\nproperty that points to this document, but its [parentNode](api:Titanium.XML.Node#parentNode)\nproperty is `null`, since it has not been inserted into the current document.\n\nFor more on node ownership, see [ownerDocument issues](https://www.w3.org/DOM/faq.html#ownerdoc)\nin the W3C DOM FAQ.\n",
      "parameters": [
        {
          "name": "importedNode",
          "summary": "Node to import.",
          "type": [
            {
              "kind": "type",
              "name": "Titanium.XML.Node"
            }
          ]
        },
        {
          "name": "deep",
          "summary": "If true, recursively import the subtree under the specified node; if false, import only the node itself.",
          "type": [
            {
              "kind": "primitive",
              "name": "Boolean"
            }
          ]
        }
      ],
      "returns": [
        {
          "type": [
            {
              "kind": "type",
              "name": "Titanium.XML.Node"
            }
          ],
          "summary": "Imported node that belongs now to this document."
        }
      ]
    }
