{
  "schemaVersion": 1,
  "name": "Titanium.Calendar.Reminder",
  "kind": "proxy",
  "extends": "Titanium.Proxy",
  "inheritanceChain": ["Titanium.Proxy"],
  "platforms": ["android"],
  "since": "3.2.0",
  "summary": "An object that represents a single reminder for an event in a calendar.",
  "description": "Reminders should be created using the [Titanium.Calendar.Event.createReminder](api:Titanium.Calendar.Event#createReminder) method \nrather than directly.\n\nSee [Titanium.Calendar](api:Titanium.Calendar) for examples of retrieving reminder information and creating \nreminders for events.\n",
  "properties": [
    {
      "name": "id",
      "platforms": ["android"],
      "summary": "Identifier of this reminder.",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ],
      "permission": "read-only"
    },
    {
      "name": "method",
      "platforms": ["android"],
      "summary": "Method by which this reminder will be delivered.",
      "type": [
        {
          "kind": "primitive",
          "name": "Number"
        }
      ],
      "permission": "read-only",
      "constants": ["Titanium.Calendar.METHOD_*"]
    },
    {
      "name": "minutes",
      "platforms": ["android"],
      "summary": "Reminder notice period in minutes, that determines how long prior to the event this reminder \nshould trigger.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "Number"
        }
      ],
      "permission": "read-only"
    }
  ],
  "methods": [],
  "events": [],
