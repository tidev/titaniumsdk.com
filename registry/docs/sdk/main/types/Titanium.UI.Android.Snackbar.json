      "name": "length",
      "platforms": ["android"],
      "summary": "Display time of the Snackbar",
      "description": "Use with on of the constants: `Ti.UI.Android.Snackbar.LENGTH_SHORT`,\n`Ti.UI.Android.Snackbar.LENGTH_LONG` or\n`Ti.UI.Android.Snackbar.LENGTH_INDEFINITE`\n",
      "type": [
        {
          "kind": "primitive",
          "name": "Number"
        }
