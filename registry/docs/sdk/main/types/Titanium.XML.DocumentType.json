{
  "schemaVersion": 1,
  "name": "Titanium.XML.DocumentType",
  "kind": "proxy",
  "extends": "Titanium.XML.Node",
  "inheritanceChain": ["Titanium.XML.Node", "Titanium.Proxy"],
  "platforms": ["android", "iphone", "ipad", "macos"],
  "since": {
    "android": "0.9",
    "iphone": "0.9",
    "ipad": "0.9",
    "macos": "9.2.0"
  },
  "summary": "Each [Titanium.XML.Document](api:Titanium.XML.Document) has a `doctype` attribute whose value is either 'null' or a [Titanium.XML.DocumentType](api:Titanium.XML.DocumentType) object.",
  "description": "This provides an interface to the list of entities that are defined for the document. Implements the\n[DOM Level 2 API](https://www.w3.org/TR/DOM-Level-2-Core/core.html#ID-412266927) on Android and iOS.\n\nAs of version 3.1, Android still does not truly support DTDs.  A document with a DTD can be\nparsed, however it is not validated, none of its default attributes will automatically be put\ninto the tree, etc.  [Google is aware of the issue](http://code.google.com/p/android/issues/detail?id=7395).\n",
  "properties": [
    {
      "name": "entities",
      "platforms": ["android", "iphone", "ipad", "macos"],
      "summary": "A [Titanium.XML.NamedNodeMap](api:Titanium.XML.NamedNodeMap) containing the general entities, both external and internal, declared in the DTD. Parameter entities are not contained. Duplicates are discarded.\n",
      "type": [
        {
          "kind": "type",
          "name": "Titanium.XML.NamedNodeMap"
        }
      ],
      "permission": "read-only"
    },
    {
      "name": "internalSubset",
      "platforms": ["android", "iphone", "ipad", "macos"],
      "summary": "The internal subset as a string.",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ],
      "permission": "read-only"
    },
    {
      "name": "name",
      "platforms": ["android", "iphone", "ipad", "macos"],
      "summary": "The name of DTD; i.e., the name immediately following the `DOCTYPE` keyword.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ],
      "permission": "read-only"
    },
    {
      "name": "notations",
      "platforms": ["android", "iphone", "ipad", "macos"],
      "summary": "A [Titanium.XML.NamedNodeMap](api:Titanium.XML.NamedNodeMap) containing the notations declared in the DTD. Duplicates are discarded. Every node in this map also implements the [Titanium.XML.Notation](api:Titanium.XML.Notation) interface.\n",
      "type": [
        {
          "kind": "type",
          "name": "Titanium.XML.NamedNodeMap"
        }
      ],
      "permission": "read-only"
    },
    {
      "name": "publicId",
      "platforms": ["android", "iphone", "ipad", "macos"],
      "summary": "The public identifier of the external subset.",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ],
      "permission": "read-only"
    },
    {
      "name": "systemId",
      "platforms": ["android", "iphone", "ipad", "macos"],
      "summary": "The system identifier of the external subset.",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ],
      "permission": "read-only"
    }
  ],
