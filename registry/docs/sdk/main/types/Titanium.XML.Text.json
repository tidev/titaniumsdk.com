  "kind": "proxy",
  "extends": "Titanium.XML.CharacterData",
  "inheritanceChain": ["Titanium.XML.CharacterData", "Titanium.XML.Node", "Titanium.Proxy"],
  "platforms": ["android", "iphone", "ipad", "macos"],
  "since": {
    "android": "0.9",
    "iphone": "0.9",
    "ipad": "0.9",
    "macos": "9.2.0"
  },
  "summary": "Represents the textual content of an [Titanium.XML.Element](api:Titanium.XML.Element) or [Titanium.XML.Attr](api:Titanium.XML.Attr) Implements the [DOM Level 2 API](https://www.w3.org/TR/DOM-Level-2-Core/core.html#ID-1312295772) on Android and iOS.",
  "properties": [
    {
      "name": "textContent",
      "platforms": ["android", "iphone", "ipad", "macos"],
      "summary": "Content (value) of all text nodes within this node.",
      "description": "On Android, `textContent` is supported on [Element](api:Titanium.XML.Element) and\n[Text](api:Titanium.XML.Text) nodes only.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "String"
        }
      ],
      "permission": "read-only"
    }
  ],
  "methods": [
    {
      "name": "splitText",
      "platforms": ["android", "iphone", "ipad", "macos"],
      "summary": "Breaks this node into two nodes at the specified by offset, and returns a new node of the same type, which contains all the content at and after the offset point. Throws an exception if the specified offset is negative or if this node is read only.",
      "parameters": [
        {
          "name": "offset",
          "summary": "The offset at which to split, starting from 0.",
          "type": [
            {
              "kind": "primitive",
              "name": "Number"
            }
          ]
        }
      ],
      "returns": [
        {
          "type": [
            {
              "kind": "type",
              "name": "Titanium.XML.Text"
            }
          ],
          "summary": "The new node, of the same type as this node"
        }
      ]
    }
  ],
