  "summary": "A set of constants for the style that can be used for the `style` property of \n[Titanium.UI.TableView](api:Titanium.UI.TableView) and [Titanium.UI.ListView](api:Titanium.UI.ListView).\n",
  "properties": [
    {
      "name": "GROUPED",
      "platforms": ["iphone", "ipad", "macos"],
      "summary": "A table view whose sections present distinct groups of rows. The section headers and footers \ndo not float.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "Number"
        }
      ],
      "permission": "read-only"
    },
    {
      "name": "INSET_GROUPED",
      "platforms": ["iphone", "ipad", "macos"],
      "summary": "A table view whose sections present distinct groups of rows  and grouped sections are inset with rounded corners. \nThe section headers and footers do not float.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "Number"
        }
      ],
      "since": {
        "iphone": "8.2.0",
        "ipad": "8.2.0",
        "macos": "9.2.0"
      },
      "permission": "read-only",
      "osver": {
        "ios": {
          "min": "13.0"
        }
      }
    },
    {
      "name": "PLAIN",
      "platforms": ["iphone", "ipad", "macos"],
      "summary": "A plain table view. Any section headers or footers are displayed as inline separators and \nfloat when the table view is scrolled.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "Number"
        }
      ],
      "permission": "read-only"
    }
  ],
