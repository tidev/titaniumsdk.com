{
  "schemaVersion": 1,
  "name": "Titanium.UI.iOS.TabbedBar",
  "kind": "view",
  "extends": "Titanium.UI.View",
  "inheritanceChain": ["Titanium.UI.View", "Titanium.Proxy"],
  "platforms": ["iphone", "ipad", "macos"],
  "since": {
    "iphone": "0.8",
    "ipad": "0.8",
    "macos": "9.2.0"
  },
  "deprecated": {
    "since": "8.0.0",
    "removed": "10.0.0",
    "notes": "Use [Titanium.UI.TabbedBar](Titanium.UI.TabbedBar) instead."
  },
  "summary": "A button bar that maintains a selected state.",
  "description": "A `TabbedBar` is a `ButtonBar` that maintains its state (visually distinguished as a pressed or \nselected look). See [ButtonBar](api:Titanium.UI.ButtonBar) for information on styling both tabbed bars and buttons bars.\n\nYou create a `TabbedBar` with the [Titanium.UI.iOS.createTabbedBar](api:Titanium.UI.iOS#createTabbedBar) factory method, or **`<TabbedBar>`** Alloy element.\n",
  "examples": [
    {
      "title": "Simple Tabbed Bar with 3 items",
      "code": "Create a tabbed bar with 3 items.\n\n``` js\nvar bb1 = Titanium.UI.iOS.createTabbedBar({\n  labels:['One', 'Two', 'Three'],\n  backgroundColor:'#336699',\n  top:50,\n  style:Titanium.UI.BUTTON_STYLE_OPTION_NEUTRAL,\n  height:25,\n  width:200\n});\nwin.add(bb1);\n```\n"
    },
    {
      "title": "Alloy XML Markup",
      "code": "Previous example as an Alloy view.\n\n``` xml\n<Alloy>\n    <Window id=\"win\">\n        <TabbedBar id=\"bb1\" platform=\"ios\" backgroundColor=\"#369\" top=\"50\" height=\"25\" width=\"200\">\n\n            <!-- The Labels tag sets the TabbedBar.labels property. -->\n            <Labels>\n\n                <!-- Specify text with node text or the title attribute. -->\n                <!-- Can also specify the enabled, image and width attributes. -->\n\n                <Label>One</Label>\n                <Label>Two</Label>\n                <Label>Three</Label>\n\n            </Labels>\n\n            <!-- Place additional views for the TabbedBar here. -->\n\n        </TabbedBar>\n    </Window>\n</Alloy>\n```\n"
    }
  ],
  "properties": [
    {
      "name": "index",
      "platforms": ["iphone", "ipad", "macos"],
      "summary": "Index of the currently selected button.",
      "type": [
        {
          "kind": "primitive",
          "name": "Number"
        }
      ]
    },
    {
      "name": "labels",
      "platforms": ["iphone", "ipad", "macos"],
      "summary": "Array of labels for the tabbed bar.",
      "description": "The labels can be specified either using an array of strings, in which case each string \ndefines the title for a button, or using an array of simple dictionary objects, \n[BarItemType](api:BarItemType), which can specify title, image, width and enabled state for each button.\n",
      "type": [
        {
          "kind": "generic",
          "name": "Array",
          "args": [
            {
              "kind": "primitive",
              "name": "String"
            }
          ]
        },
        {
          "kind": "generic",
          "name": "Array",
          "args": [
            {
              "kind": "type",
              "name": "BarItemType"
            }
          ]
        }
      ]
    },
    {
      "name": "style",
      "platforms": ["iphone", "ipad", "macos"],
      "summary": "Style of the tabbed bar.",
      "description": "The `BAR` style specifies a more compact style and allows the bar's background color or \ngradient to show through.\n",
      "type": [
        {
          "kind": "primitive",
          "name": "Number"
        }
      ],
      "default": "Titanium.UI.BUTTON_STYLE_OPTION_NEUTRAL",
      "constants": ["Titanium.UI.BUTTON_STYLE_OPTION_*"]
    }
  ],
