  "summary": "The top level XML module.  The XML module is used for parsing and processing XML-based content.",
  "description": "The API for this module is based on the W3C DOM specification.\n\nAndroid and iOS implement the [DOM Level 2](https://www.w3.org/TR/DOM-Level-2-Core/core.html) specification\nwith some non-standard extensions, which are documented in the appropriate places.\n\nBoth iOS and Android lack DTD support.\n",
  "properties": [],
  "methods": [
    {
      "name": "parseString",
      "platforms": ["android", "iphone", "ipad", "macos"],
      "summary": "Parses an XML string into a [Titanium.XML.Document](api:Titanium.XML.Document) object.\n",
      "description": "Throws an exception if the string can't be parsed into a valid document.",
      "parameters": [
        {
          "name": "xml",
          "summary": "XML content as a string.",
          "type": [
            {
              "kind": "primitive",
              "name": "String"
            }
          ]
        }
      ],
      "returns": [
        {
          "type": [
            {
              "kind": "type",
              "name": "Titanium.XML.Document"
            }
          ]
        }
      ]
    },
    {
      "name": "serializeToString",
      "platforms": ["android", "iphone", "ipad", "macos"],
      "summary": "Serializes a [Node](api:Titanium.XML.Node) object into a string.",
      "parameters": [
        {
          "name": "node",
          "summary": "XML [Node](api:Titanium.XML.Node) to serialize.",
          "type": [
            {
              "kind": "type",
