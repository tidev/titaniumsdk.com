  "methods": [
    {
      "name": "setImage",
      "platforms": ["iphone", "ipad", "macos"],
      "summary": "Changes the image for a specified index.",
      "description": "To specify a size for the image, you may pass the image as a simple dictionary, as defined \nin [CoverFlowImageType](api:CoverFlowImageType).  If you specify a size, the size must be exact, not a\npercentage size. \n\nIf the image is passed as a `File` object or file path, the filename is checked. If the \nfilename includes the '@2x' or '@3x' string used to identify high-resolution images for the Retina (HD) \ndisplay, the image is treated accordingly.\n",
      "parameters": [
        {
          "name": "index",
