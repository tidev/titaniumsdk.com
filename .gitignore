# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ai
.claude

# Doc images, mirrored from registry/ at build time by scripts/sync-doc-assets.ts
public/docs/

# Generated by scripts/generate-search-index.ts during the build. Never
# committed: an index that ships separately from the registry it describes can
# be stale, and this way it cannot be.
public/_pagefind/
